<isinclude template="/components/modules" sf-toolkit="off" />

<isif condition="${pdict.reportingURLs && pdict.reportingURLs.length}">
    <isinclude template="reporting/reportingUrls" />
</isif>

<div class="product-list-page">
    <div class="plp-header" style="
            background-color: ${pdict.topBannerBackgroundColor ? pdict.topBannerBackgroundColor : '#fff'};
            background-image: ${pdict.bannerImageUrl ? 'url(' + pdict.bannerImageUrl + ')' : 'none'};
            color: ${pdict.topBannerTextColor ? pdict.topBannerTextColor : '#232323'};
            background-repeat: ${pdict.topBannerBackgroundRepeat ? pdict.topBannerBackgroundRepeat : 'no-repeat'};
            background-size: ${pdict.topBannerBackgroundSize ? pdict.topBannerBackgroundSize : 'cover'};
            background-position: ${pdict.topBannerBackgroundPosition ? pdict.topBannerBackgroundPosition : 'center'};">
        <isif condition="${pdict.topBannerTextColor}">
            <style type="text/css">
                .breadcrumb-item {
                    color: ${pdict.topBannerTextColor} !important;
                }
                .breadcrumb-item::before {
                    color: ${pdict.topBannerTextColor} !important;
                }
                .breadcrumb-item a {
                    color: ${pdict.topBannerTextColor} !important;
                }
            </style>
        </isif>
        <div class="container">
            <isif condition="${pdict.productSearch.isCategorySearch}">
                <isinclude template="components/breadcrumbs/pageBreadcrumbs" />
            </isif>

            <isif condition="${pdict.productSearch.isCategorySearch}">
                <isif condition="${!empty(pdict.productSearch.category.description)}">
                    <isprint value="${pdict.productSearch.category.description}" encoding="off" />
                <iselse/>
                    <h1>${pdict.productSearch.category.name}</h1>
                </isif>
            </isif>

            <isif condition="${pdict.apiProductSearch && pdict.apiProductSearch.category}">
                <div class="plp-top-content">
                    <isslot
                        id="plp-top-content-slot"
                        context="category"
                        description="Slot above product tiles"
                        context-object="${pdict.apiProductSearch.category}"
                    />
                </div>
            </isif>
        </div>
    </div>
    <div class="plp-header-asset">
        <isif condition="${pdict.topBannerContentAssetID && require('dw/content/ContentMgr').getContent(pdict.topBannerContentAssetID).isOnline()}">
            <iscontentasset aid="${pdict.topBannerContentAssetID}" />
        </isif>
    </div>

    <div class="container search-results" <isif condition="${pdict.gtm_data}">data-gtm="${pdict.gtm_data}"</isif>>
        <isif condition="${!pdict.productSearch.isCategorySearch}">
            <h1 class="mt-4">${Resource.msg('label.header.banner', 'search', null)}</h1>
            <isif condition="${pdict.contentSearchCount > 0}">
                <div class="row article-section mt-2">
                    <div class="col-sm-12 col-md-3">
                        <div class="left-column">
                            <h2 class="article-section-title">${Resource.msg('label.header.banner.article', 'search', null)}</h2>
                            <isif condition="${pdict.contentSearchCount > 3}">
                                <button class="content-search article-section-button btn btn-primary hidden-sm-down" data-url="${URLUtils.url('Search-Content', 'q', pdict.productSearch.searchKeywords, 'startingPage', 3, 'pageSize', 5)}">
                                    ${Resource.msg('button.load.article', 'search', null)}
                                </button>
                            </isif>
                        </div>
                    </div>

                    <div class="col-sm-12 col-md-9">
                        <isinclude url="${URLUtils.url("Search-ContentPreview", 'q', pdict.productSearch.searchKeywords, 'startingPage', 0)}" />
                    </div>

                    <isif condition="${pdict.contentSearchCount > 2}">
                        <button class="content-search article-section-button btn btn-primary d-md-none" data-url="${URLUtils.url('Search-Content', 'q', pdict.productSearch.searchKeywords, 'startingPage', 2, 'pageSize', 5)}">
                            ${Resource.msg('button.load.article', 'search', null)}
                        </button>
                    </isif>

                    <div class="row">
                        <div class="col-12">
                            <div class="article-body" id="content-search-results-pane">
                                <div id="content-search-results"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </isif>
        </isif>

        <div class="row">
            <div class="tab-content col-12">
                <div class="tab-pane container active" id="product-search-results" role="tabpanel" aria-labelledby="product-tab">
                    <isif condition="${pdict.productSearch.productIds.length === 0}">
                        <div class="row grid-header justify-content-center">
                            <div class="result-count col">
                                <isinclude template="search/resultsCount" />
                            </div>
                        </div>
                    </isif>

                    <isif condition="${pdict.productSearch.productIds.length > 0}">
                        <div class="row">
                            <div class="refinement-bar col-md-3" <isif condition="${pdict.gtmDataVPV}">data-gtm="${pdict.gtmDataVPV}"</isif>>
                                <div class="grid-header result-count d-none d-md-flex justify-content-between">
                                    <isinclude template="search/resultsCount" />
                                    <button class="reset" data-href="${pdict.productSearch.resetLink}">
                                        ${Resource.msg('button.clear.filters', 'search', null)}
                                    </button>
                                </div>
                                <div class="row filter-bar d-none d-md-block mx-0">
                                    <isinclude template="search/filterBar" />
                                </div>

                                <isinclude template="search/searchRefineBar"/>
                            </div>

                            <div class="col-sm-12 col-md-9 pt-3 pt-md-4">
                                <div class="row m-0 d-flex justify-content-between product-grid-header">
                                    <isinclude template="search/headerRefinements" />

                                    <div class="col-6 col-sm-5 col-xl-4 col-xxl-3 order-sm-1 pl-0">
                                        <isinclude template="search/sortOrderMenu" />
                                    </div>

                                    <div class="col-6 col-sm-3 text-right d-md-none order-sm-3 pr-0">
                                        <button type="button" class="btn btn-primary filter-results col-12">
                                            ${Resource.msg('button.filter', 'search', null)}
                                        </button>
                                    </div>
                                </div>

                                <div class="row filter-bar d-md-none">
                                    <isinclude template="search/filterBar" />
                                </div>

                                <div class="row d-md-none align-items-center product-count">
                                    <isinclude template="search/productCount" />
                                </div>

                                <div class="row product-grid js-gtm-product-impressions row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4" <isif condition="${pdict.gtmDataProductList}">data-gtm="${pdict.gtmDataProductList}"</isif> itemtype="http://schema.org/SomeProducts" itemid="#product">
                                    <isinclude template="search/productGrid" />
                                </div>
                            </div>
                        </div>
                    </isif>
                </div>
            </div>
        </div>
    </div>
</div>
